rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can manage their own user document
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      // Premium entitlements are written only by trusted server code.
      allow create: if isOwner(userId)
                    && request.resource.data.get('plan', 'FREE') == 'FREE';
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);
    }

    // Users can manage their own preferences document
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Users can manage their own categories
    match /categories/{categoryId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && isOwner(request.resource.data.userId);
    }

    // Users can manage their own tasks
    match /tasks/{taskId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && isOwner(request.resource.data.userId);
    }

    // Users can manage their own schedule blocks
    match /schedule_blocks/{blockId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && isOwner(request.resource.data.userId);
    }

    // Users can manage their own pomodoro logs
    match /pomodoro_logs/{logId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && isOwner(request.resource.data.userId);
    }
  }
}